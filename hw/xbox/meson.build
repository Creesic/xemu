if host_os == 'windows'
  xemu_plume_d3d12_source = custom_target(
    'xemu-plume-d3d12.cpp',
    input: files('../../thirdparty/plume/plume_d3d12.cpp'),
    output: 'xemu-plume-d3d12.cpp',
    command: [
      python,
      files('../../scripts/xemu-plume-source.py'),
      '@INPUT@',
      '@OUTPUT@',
    ],
  )
  xemu_d3d_hle_inc = include_directories(
    'd3d_hle',
    'd3d_hle/plume',
    '../../thirdparty/plume',
    '../../thirdparty/plume/contrib/D3D12MemoryAllocator/include',
    '../../thirdparty/xbsymbol-database/include',
    '../../thirdparty/xbsymbol-database/src/OOVPADatabase',
  )
  xemu_d3d_hle_dep = declare_dependency(
    include_directories: xemu_d3d_hle_inc,
    compile_args: [
      '-DPLUME_D3D12_ENABLED=1',
      '-DWIN32_LEAN_AND_MEAN',
      '-DNOMINMAX',
      '-DXEMU_D3D_HLE_NO_DXC_LIBRARY=1',
      '-D_CRT_SECURE_NO_WARNINGS',
      '-DXRECOMP_D3D_HLE_CONFIG_AVAILABLE=1',
      '-DXRECOMP_D3D_HLE_PLAN_READY=1',
      '-DXRECOMP_D3D_HLE_RUNTIME_READY=1',
      '-DXRECOMP_D3D_HLE_REQUIRED_HOOKS=92',
      '-DXRECOMP_D3D_HLE_IMPLEMENTED_HOOKS=92',
      '-DXRECOMP_D3D_HLE_BLOCKER_COUNT=0',
    ],
    dependencies: [
      cc.find_library('d3d12', required: true),
      cc.find_library('dxgi', required: true),
      cc.find_library('dxguid', required: true),
    ],
  )
  specific_ss.add(files(
    'd3d_hle/xemu_d3d_hle.c',
    'd3d_hle/xemu_d3d_hle_discovery.c',
    'd3d_hle/xemu_xbsdb_d3d_only.c',
    'd3d_hle/xemu_d3d_hle_mm3.c',
    'd3d_hle/xemu_d3d_hle_pgr2.c',
    'd3d_hle/xemu_d3d_hle_profiles.c',
    'd3d_hle/xemu_d3d_hle_stubs.c',
    'd3d_hle/d3d_frontend.c',
    'd3d_hle/d3d_hle_guest.c',
    'd3d_hle/d3d_hle_guest_driver.c',
    'd3d_hle/d3d_hle_guest_api.c',
    'd3d_hle/d3d_hle_deferred_state.c',
    'd3d_hle/d3d_hle_device_get_caps.c',
    'd3d_hle/d3d_hle_device_get_direct3d.c',
    'd3d_hle/d3d_hle_device_create_pixel_shader.c',
    'd3d_hle/d3d_hle_device_create_texture2.c',
    'd3d_hle/d3d_hle_device_create_vertex_shader.c',
    'd3d_hle/d3d_hle_device_draw_indexed_vertices.c',
    'd3d_hle/d3d_hle_device_draw_vertices.c',
    'd3d_hle/d3d_hle_device_load_vertex_shader.c',
    'd3d_hle/d3d_hle_device_set_indices.c',
    'd3d_hle/d3d_hle_device_set_stream_source.c',
    'd3d_hle/d3d_hle_device_switch_texture.c',
    'd3d_hle/d3d_hle_resource_get_type.c',
    'd3d_hle/d3d_hle_resource_is_busy.c',
    'd3d_hle/d3d_hle_resource_release.c',
    'd3d_hle/d3d_hle_surface_lock_rect.c',
    'd3d_hle/d3d_hle_surface_get_desc.c',
    'd3d_hle/d3d_hle_texture_get_level_desc.c',
    'd3d_hle/d3d_hle_texture_get_surface_level2.c',
    'd3d_hle/d3d_hle_vertex_buffer_lock2.c',
    'd3d_hle/d3d_hle_state_border_color.c',
